# Organisers' GET link from page 3 of the guide (the "Открыть GET для DEV" button).
# group_id is added by the app, so it can be left in or removed.
CQA_API_URL=
# Gemini API key from https://aistudio.google.com (free tier). NOT the Gemini Plus subscription.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# Paid-tier price per 1M tokens (USD), for the cost estimate. Leave empty on the free tier.
LLM_PRICE_IN=
LLM_PRICE_OUT=
PORT=8080
