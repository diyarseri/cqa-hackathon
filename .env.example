# Organisers' GET link from page 3 of the guide (the "Открыть GET для DEV" button).
# group_id is added by the app, so it can be left in or removed.
CQA_API_URL=
# Strict local mode: the server rejects every non-loopback model address.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# A laptop model can take several minutes on a long transcript.
OLLAMA_TIMEOUT_MS=300000
OLLAMA_CONTEXT_TOKENS=8192
OLLAMA_MAX_TOKENS=8000
# One run is recommended for 16 GB RAM / RTX 4050. More runs multiply the time.
EVAL_RUNS=1
PORT=8080
